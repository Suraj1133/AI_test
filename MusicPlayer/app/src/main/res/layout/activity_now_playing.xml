<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/now_playing_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="NOW PLAYING"
            android:textColor="#D8CCFF"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="22dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="14dp">

            <ImageView
                android:id="@+id/nowPlayingArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Album artwork"
                android:scaleType="centerCrop"
                android:src="@drawable/player_art_placeholder"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/nowPlayingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/nowPlayingArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#C9BFE2"
            android:textSize="16sp"/>

        <SeekBar
            android:id="@+id/nowPlayingSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:progressTint="#FFFFFF"
            android:thumbTint="#FFFFFF"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/elapsedTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#C9BFE2"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#C9BFE2"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nowPlayingPrevious"
                android:contentDescription="Previous soundtrack"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="72dp"
                android:layout_height="64dp"
                android:text="|◀"
                android:textColor="#FFFFFF"
                android:textSize="22sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nowPlayingPlayPause"
                android:contentDescription="Play or pause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="16dp"
                android:text="Ⅱ"
                android:textColor="#402268"
                android:textSize="27sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="38dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nowPlayingNext"
                android:contentDescription="Next soundtrack"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="72dp"
                android:layout_height="64dp"
                android:text="▶|"
                android:textColor="#FFFFFF"
                android:textSize="22sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nowPlayingShuffle"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Shuffle"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nowPlayingRepeat"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Repeat Off"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nowPlayingSpeed"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="1×"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nowPlayingQueue"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Queue"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
