<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/now_playing_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/nowPlayingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOW PLAYING"
        android:textColor="#D8CCFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/artworkCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="14dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.84"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nowPlayingArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/player_art_placeholder"
            android:contentDescription="Album artwork"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/nowPlayingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/artworkCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/nowPlayingArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:gravity="center"
        android:textColor="#C9BFE2"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <SeekBar
        android:id="@+id/nowPlayingSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:progressTint="#FFFFFF"
        android:thumbTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingArtist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/elapsedTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textColor="#C9BFE2"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingSeekBar"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/totalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textColor="#C9BFE2"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingSeekBar"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/playerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/elapsedTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nowPlayingPrevious"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:text="|◀"
            android:textColor="#FFFFFF"
            android:textSize="22sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nowPlayingPlayPause"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="16dp"
            android:text="Ⅱ"
            android:textColor="#402268"
            android:textSize="27sp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="38dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nowPlayingNext"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:text="▶|"
            android:textColor="#FFFFFF"
            android:textSize="22sp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
