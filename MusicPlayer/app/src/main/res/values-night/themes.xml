<resources>
    <style name="Base.Theme.MusicPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.MusicPlayer.Lavender" parent="Base.Theme.MusicPlayer">
        <item name="colorPrimary">#D0BCFF</item><item name="colorSecondary">#CCC2DC</item>
        <item name="colorPrimaryContainer">#4F378B</item><item name="colorOnPrimaryContainer">#EADDFF</item>
        <item name="android:colorAccent">#D0BCFF</item>
    </style>
    <style name="Theme.MusicPlayer.Ocean" parent="Base.Theme.MusicPlayer">
        <item name="colorPrimary">#9ECAFF</item><item name="colorSecondary">#B7C9D8</item>
        <item name="colorPrimaryContainer">#00497D</item><item name="colorOnPrimaryContainer">#D1E4FF</item>
        <item name="android:colorAccent">#9ECAFF</item>
    </style>
    <style name="Theme.MusicPlayer.Emerald" parent="Base.Theme.MusicPlayer">
        <item name="colorPrimary">#6EDBAF</item><item name="colorSecondary">#B4CCBF</item>
        <item name="colorPrimaryContainer">#00513A</item><item name="colorOnPrimaryContainer">#89F8C7</item>
        <item name="android:colorAccent">#6EDBAF</item>
    </style>
    <style name="Theme.MusicPlayer.Sunset" parent="Base.Theme.MusicPlayer">
        <item name="colorPrimary">#FFB3B5</item><item name="colorSecondary">#E6BDBD</item>
        <item name="colorPrimaryContainer">#7E2A30</item><item name="colorOnPrimaryContainer">#FFDADB</item>
        <item name="android:colorAccent">#FFB3B5</item>
    </style>
    <style name="Theme.MusicPlayer.Rose" parent="Base.Theme.MusicPlayer">
        <item name="colorPrimary">#FFB1C5</item><item name="colorSecondary">#E3BDC6</item>
        <item name="colorPrimaryContainer">#713247</item><item name="colorOnPrimaryContainer">#FFD9E2</item>
        <item name="android:colorAccent">#FFB1C5</item>
    </style>

    <style name="Theme.MusicPlayer" parent="Theme.MusicPlayer.Lavender"/>
</resources>
